{
  "name": "@incidentcompanion/server",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "description": "The NestJS backend, built beside the legacy Python one. Topology-blind: it reads DATABASE_URL and REDIS_URL and never learns whether they point at localhost or a cluster.",
  "engines": {
    "node": ">=26"
  },
  "//scarfSettings": "@nestjs/swagger depends on swagger-ui-dist, which depends on @scarf/scarf purely so its postinstall runs and reports the install to scarf.sh. Nothing requires it at runtime. Read from the root package.json by report.js, so every clone inherits the opt-out rather than relying on an env var somebody has to remember.",
  "scarfSettings": {
    "enabled": false
  },
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "check": "npm run typecheck && vitest run",
    "dev": "NODE_ENV=development nest start --watch",
    "repl": "nest start --entryFile repl",
    "start": "node dist/src/main.js",
    "seed": "node dist/src/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "node scripts/reset-policies.mjs && drizzle-kit push",
    "db:up": "node scripts/stack.mjs --compose up -d --wait && node scripts/stack.mjs --roles",
    "db:down": "node scripts/stack.mjs --compose down",
    "e2e": "playwright test --config=e2e/playwright.config.ts",
    "visual": "playwright test --config=e2e/visual/playwright.visual.config.ts",
    "visual:dist": "VISUAL_TARGET=dist playwright test --config=e2e/visual/playwright.visual.config.ts",
    "visual:storybook": "playwright test --config=e2e/visual/playwright.storybook.config.ts",
    "audit:affordances": "playwright test --config=e2e/visual/playwright.affordance.config.ts"
  },
  "dependencies": {
    "@incidentcompanion/prose-schema": "*",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/terminus": "^12.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@node-rs/argon2": "^2.0.2",
    "@thallesp/nestjs-better-auth": "^2.7.0",
    "@tiptap/core": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/y-tiptap": "^3.0.8",
    "@zip.js/zip.js": "^2.8.48",
    "age-encryption": "^0.3.0",
    "better-auth": "1.7.2",
    "compression": "^1.8.1",
    "csv-parse": "7.0.2",
    "csv-stringify": "6.8.3",
    "docx": "^9.7.1",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "fontkit": "^2.0.4",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "lib0": "^0.2.117",
    "nestjs-zod": "^5.5.0",
    "pdfmake": "^0.3.11",
    "pg": "^8.23.0",
    "rate-limiter-flexible": "11.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "selfsigned": "^5.5.0",
    "sharp": "^0.35.3",
    "ws": "^8.21.3",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.0",
    "@nestjs/schematics": "12.0.0",
    "@nestjs/testing": "12.0.1",
    "@playwright/test": "1.62.1",
    "@redocly/openapi-core": "2.51.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.1",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/node": "26.4.1",
    "@types/pdfmake": "0.3.3",
    "@types/pg": "8.23.1",
    "@types/proper-lockfile": "4.1.4",
    "@types/ws": "8.18.1",
    "chokidar": "5.0.0",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "eslint": "10.9.1",
    "eslint-plugin-drizzle": "0.2.3",
    "eslint-plugin-n": "18.3.0",
    "eslint-plugin-playwright": "2.11.0",
    "eslint-plugin-regexp": "3.2.0",
    "proper-lockfile": "4.1.2",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "@thallesp/nestjs-better-auth": {
      "better-auth": "1.7.2"
    }
  }
}
