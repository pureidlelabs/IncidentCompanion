{
  "name": "@incidentcompanion/prose-schema",
  "version": "0.1.0",
  "private": true,
  "description": "The one definition of what a report body may contain, shared by the editor and the server so the two cannot disagree about the document's shape.",
  "license": "AGPL-3.0-only",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2"
  }
}
