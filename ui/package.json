{
  "name": "@incidentcompanion/ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "The React front end. Self-contained: its own node_modules and its own Tailwind build, so the Vite root is ui/ and nothing outside it is scanned.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "npm run demo:catalogue && VITE_DEMO=1 tsc -b && VITE_DEMO=1 VITE_DEMO_BUILD=\"${VITE_DEMO_BUILD:-$(git rev-parse --short HEAD 2>/dev/null || echo local)}\" vite build && cp dist/index.html dist/404.html && cp ../server/assets/favicon.* ../server/assets/logo*.svg dist/",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p ${STORYBOOK_PORT:-6006} --no-open",
    "build-storybook": "storybook build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo:catalogue": "cd ../server && npm exec -- tsx scripts/demo-catalogue.mts ../ui/src/demo/catalogue"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.17.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@incidentcompanion/prose-schema": "*",
    "@internationalized/date": "^3.12.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^9.1.2",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-collaboration": "^3.29.2",
    "@tiptap/extension-collaboration-caret": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/extensions": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/suggestion": "^3.29.2",
    "@tiptap/y-tiptap": "^3.0.8",
    "better-auth": "^1.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "7.0.2",
    "cytoscape": "^3.34.2",
    "cytoscape-fcose": "^2.2.0",
    "lib0": "^0.2.117",
    "lucide-react": "^1.28.0",
    "motion": "^13.1.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "tiptap-markdown": "^0.9.0",
    "tw-animate-css": "^1.4.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.18.7",
    "@eslint/js": "10.0.1",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-mcp": "0.7.0",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "4.1.11",
    "eslint": "10.9.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "eslint-plugin-storybook": "10.5.10",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "storybook": "10.5.10",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "tailwindcss-react-aria-components": "2.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "brace-expansion": "^5.0.9"
  }
}
