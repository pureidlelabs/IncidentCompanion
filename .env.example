# What an operator may set, in the `.env` beside `compose.yaml` that
# `docker/secrets.sh` writes. Every line is optional; unset, the install is
# reachable from this machine alone, at https://localhost.

# **Reaching it from other machines is these two lines, together.** The name
# analysts type -- a DNS name or an IPv4 address -- and the address on this
# host to publish on. A name alone is unreachable from elsewhere; an address
# alone answers only `localhost`, which no browser elsewhere sends. A named
# install answers at its name and nowhere else, `localhost` included.
#IC_NAME=ir.soc.example
#IC_LISTEN=192.0.2.10

# The port analysts reach it on. The publish and the base URL move together:
# a browser's `Origin` carries this port, and an origin the install cannot
# derive is refused.
#IC_STACK_PORT=443

# The compose project name, which is also the prefix on every volume. Change it
# and the stack starts empty, because `incidentcompanion_ic-db` is not the
# volume `myproject_ic-db`.
#IC_STACK_PROJECT=incidentcompanion

# Whether analysts may import incidents from Microsoft Sentinel. The browser
# then talks to Azure's sign-in and management origins, and every page's
# content policy names both. Off unless set.
#IC_SENTINEL_IMPORTER=on
